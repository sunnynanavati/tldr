{
  "name": "tldr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "dev:server": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "dev:fixtures": "node --env-file-if-exists=.env --import tsx scripts/fixture-server.ts",
    "build": "node --import tsx scripts/build.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "check": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts eslint.config.js",
    "test": "vitest run",
    "test:ai": "node --env-file-if-exists=.env --import tsx scripts/smoke-ai.ts",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
