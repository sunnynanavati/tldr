{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node", "chrome", "vite/client"]
  },
  "include": ["src", "scripts", "tests", "vite.config.ts"]
}
